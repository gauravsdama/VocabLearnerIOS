{
  "name": "vocabcat-ios",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "assets:generate": "node scripts/generate-assets.mjs",
    "screenshots:validate": "node scripts/validate-screenshots.mjs",
    "privacy:check": "node scripts/release-privacy-check.mjs",
    "license:check": "node scripts/check-licensing.mjs",
    "copy:inventory": "node scripts/inventory-ui-copy.mjs --write",
    "copy:inventory:check": "node scripts/inventory-ui-copy.mjs",
    "ios:build:preview": "eas build --platform ios --profile preview",
    "ios:build:prod": "eas build --platform ios --profile production",
    "ios:submit": "eas submit --platform ios --profile production",
    "test:unit": "tsc -p tsconfig.tests.json && node --test .tmp-test-dist/tests/*.test.js",
    "test:component": "jest --runInBand",
    "test:e2e": "maestro test .maestro/smoke.yaml",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev",
    "release:verify": "npm run test:unit && npm run test:component && npm run typecheck && npm run audit:prod && npm run privacy:check && npm run copy:inventory:check && npm run license:check"
  },
  "dependencies": {
    "@expo-google-fonts/sora": "^0.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "expo": "~57.0.23",
    "expo-apple-authentication": "~57.0.2",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "msw": "^2.14.6",
    "react-test-renderer": "^19.1.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}

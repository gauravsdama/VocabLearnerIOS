{
  "name": "vocabcat-ios",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "assets:generate": "node scripts/generate-assets.mjs",
    "screenshots:validate": "node scripts/validate-screenshots.mjs",
    "ios:build:preview": "eas build --platform ios --profile preview",
    "ios:build:prod": "eas build --platform ios --profile production",
    "ios:submit": "eas submit --platform ios --profile production",
    "test:unit": "tsc -p tsconfig.tests.json && node --test .tmp-test-dist/tests/*.test.js",
    "test:component": "jest --runInBand",
    "test:e2e": "maestro test .maestro/smoke.yaml"
  },
  "dependencies": {
    "@expo-google-fonts/sora": "^0.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "expo": "~54.0.31",
    "expo-apple-authentication": "~8.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.10",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "^54.0.10",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "msw": "^2.14.6",
    "react-test-renderer": "^19.1.0",
    "sharp": "^0.33.5",
    "typescript": "~5.9.2"
  }
}
